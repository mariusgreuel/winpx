<?xml version="1.0" encoding="utf-8"?>

<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap5="http://schemas.microsoft.com/appx/manifest/uap/windows10/5"
  xmlns:uap18="http://schemas.microsoft.com/appx/manifest/uap/windows10/18"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  IgnorableNamespaces="uap uap5 uap18 rescap desktop">

  <Identity
    Name="mgtek.com.WinPX"
    Publisher="CN=14EB2942-3EE1-44D2-92E0-0754A0223CC9"
    Version="1.3.62.0" />

  <Properties>
    <DisplayName>WinPX</DisplayName>
    <PublisherDisplayName>mgtek.com</PublisherDisplayName>
    <Logo>Images\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.14393.0" MaxVersionTested="10.0.26300.0" />
  </Dependencies>

  <Resources>
    <Resource Language="x-generate"/>
  </Resources>

  <Applications>
    <Application
      Id="GuiWinPX"
      Executable="gui\winpx.exe"
      EntryPoint="Windows.FullTrustApplication"
      uap18:TrustLevel="mediumIL"
      uap18:RuntimeBehavior="win32App">
      <uap:VisualElements
        DisplayName="WinPX Proxy Server"
        Description="WinPX is a forwarding HTTP proxy server for Windows designed to help legacy applications connect to enterprise proxy servers."
        BackgroundColor="transparent"
        Square150x150Logo="Images\Square150x150Logo.png"
        Square44x44Logo="Images\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Images\Wide310x150Logo.png" />
        <uap:SplashScreen Image="Images\SplashScreen.png" />
      </uap:VisualElements>
      <Extensions>
        <uap5:Extension Category="windows.appExecutionAlias">
          <uap5:AppExecutionAlias>
            <uap5:ExecutionAlias Alias="winpx.exe" />
          </uap5:AppExecutionAlias>
        </uap5:Extension>
        <desktop:Extension Category="windows.startupTask">
          <desktop:StartupTask
            TaskId="WinPX"
            Enabled="true"
            DisplayName="WinPX Proxy Server" />
        </desktop:Extension>
      </Extensions>
    </Application>
    <Application
      Id="CliWinPX"
      Executable="console\winpxc.exe"
      EntryPoint="Windows.FullTrustApplication"
      uap18:TrustLevel="mediumIL"
      uap18:RuntimeBehavior="win32App">
      <uap:VisualElements
        DisplayName="WinPX Proxy Server (CLI)"
        Description="WinPX is a forwarding HTTP proxy server for Windows designed to help legacy applications connect to enterprise proxy servers."
        AppListEntry="none"
        BackgroundColor="transparent"
        Square150x150Logo="Images\Square150x150Logo.png"
        Square44x44Logo="Images\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Images\Wide310x150Logo.png" />
        <uap:SplashScreen Image="Images\SplashScreen.png" />
      </uap:VisualElements>
      <Extensions>
        <uap5:Extension Category="windows.appExecutionAlias">
          <uap5:AppExecutionAlias>
            <uap5:ExecutionAlias Alias="winpxc.exe" />
          </uap5:AppExecutionAlias>
        </uap5:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
