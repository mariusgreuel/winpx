root = true

[*.{c,h,cpp,hpp,cxx,hxx,inl}]
charset = utf-8
indent_size = 4
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

[*.{md,txt}]
charset = utf-8
indent_size = 4
indent_style = space

[*.{bat,cmd}]
charset = latin1
indent_size = 4
indent_style = space
end_of_line = crlf

[*.ps1]
charset = utf-8-bom
indent_size = 4
indent_style = space
end_of_line = lf

[*.{xml,yml}]
charset = utf-8
indent_size = 2
indent_style = space
