<decimalTextBox refId="ResolveTimeout" defaultValue="5000" spin="true">Resolve Timeout:</decimalTextBox>
      </presentation>
      <presentation id="ConnectTimeout">
<text>Enter the timeout duration for establishing a HTTP connection in milliseconds.</text>
<decimalTextBox refId="ConnectTimeout" defaultValue="5000" spin="true">Connect Timeout:</decimalTextBox>
      </presentation>
      <presentation id="ReadTimeout">
