    <policy name="ReuseSocketAddresses" class="Both" displayName="$(string.ReuseSocketAddresses)" explainText="$(string.ReuseSocketAddresses_Help)" key="Software\Policies\Marius Greuel\WinPX" valueName="ReuseSocketAddresses">
