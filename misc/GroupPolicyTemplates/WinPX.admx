<policyDefinitions xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" revision="1.0" schemaVersion="1.0" xmlns="http://schemas.microsoft.com/GroupPolicy/2006/07/PolicyDefinitions">
  <policyNamespaces>
    <target prefix="winpx" namespace="MariusGreuel.Policies.WinPX" />
    <using prefix="windows" namespace="Microsoft.Policies.Windows" />
  </policyNamespaces>
  <resources minRequiredRevision="1.0" fallbackCulture="en-US" />
  <categories>
    <category name="WinPX" displayName="$(string.WinPX)">
    </category>
  </categories>
  <policies>
    <policy name="ProxyMode" class="Both" displayName="$(string.ProxyMode)" explainText="$(string.ProxyMode_Help)" presentation="$(presentation.ProxyMode)" key="Software\Policies\Marius Greuel\WinPX">
      <parentCategory ref="WinPX" />
      <supportedOn ref="windows:SUPPORTED_Windows_10_0" />
      <elements>
        <enum id="ProxyMode_Dropdown" valueName="ProxyMode">
          <item displayName="$(string.ProxyMode_Default)">
            <value>
              <decimal value="0" />
            </value>
          </item>
          <item displayName="$(string.ProxyMode_System)">
            <value>
              <decimal value="1" />
            </value>
          </item>
          <item displayName="$(string.ProxyMode_Direct)">
            <value>
              <decimal value="2" />
            </value>
          </item>
          <item displayName="$(string.ProxyMode_Manual)">
            <value>
              <decimal value="3" />
            </value>
          </item>
          <item displayName="$(string.ProxyMode_AutoConfig)">
            <value>
              <decimal value="4" />
            </value>
          </item>
          <item displayName="$(string.ProxyMode_AutoDetect)">
            <value>
              <decimal value="5" />
            </value>
          </item>
        </enum>
      </elements>
    </policy>
    <policy name="NetworkMode" class="Both" displayName="$(string.NetworkMode)" explainText="$(string.NetworkMode_Help)" presentation="$(presentation.NetworkMode)" key="Software\Policies\Marius Greuel\WinPX">
      <parentCategory ref="WinPX" />
      <supportedOn ref="windows:SUPPORTED_Windows_10_0" />
      <elements>
        <enum id="NetworkMode_Dropdown" valueName="NetworkMode">
          <item displayName="$(string.NetworkMode_Loopback)">
            <value>
              <decimal value="0" />
            </value>
          </item>
          <item displayName="$(string.NetworkMode_LoopbackAndWsl)">
            <value>
              <decimal value="1" />
            </value>
          </item>
          <item displayName="$(string.NetworkMode_Any)">
            <value>
              <decimal value="2" />
            </value>
          </item>
        </enum>
      </elements>
    </policy>
    <policy name="AllowNegotiate" class="Both" displayName="$(string.AllowNegotiate)" explainText="$(string.AllowNegotiate_Help)" key="Software\Policies\Marius Greuel\WinPX" valueName="AllowNegotiate">
      <parentCategory ref="WinPX" />
      <supportedOn ref="windows:SUPPORTED_Windows_10_0" />
      <enabledValue>
        <decimal value="1" />
      </enabledValue>
      <disabledValue>
