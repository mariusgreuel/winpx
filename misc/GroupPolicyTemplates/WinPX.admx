    <policy name="AutoConfigUrl" class="Both" displayName="$(string.AutoConfigUrl)" explainText="$(string.AutoConfigUrl_Help)" presentation="$(presentation.AutoConfigUrl)" key="Software\Policies\Marius Greuel\WinPX">
      <parentCategory ref="WinPX" />
